# Copy to a protected deployment environment; supply real values through a secret manager.
ENVIRONMENT=production
AUTH_SECRET=replace-with-a-generated-random-secret
DATABASE_URL=postgresql+psycopg://ocr:replace-password@db:5432/ocr_land
DEMO_AUTH_ENABLED=false
LOCAL_AUTH_ENABLED=false
OIDC_ENABLED=true
OIDC_ISSUER=https://replace-with-your-issuer.example
OIDC_CLIENT_ID=replace-client-id
OIDC_CLIENT_SECRET=replace-client-secret
OIDC_REDIRECT_URI=https://replace-with-your-host.example/api/auth/oidc/callback
OIDC_AUTO_PROVISION=false
REDIS_URL=redis://redis:6379/0
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SECURE_UPLOAD_DIR=/var/lib/aranyasetu/private_uploads
LAND_COVER_WEIGHTS_PATH=/var/lib/aranyasetu/models/dynamic_world.pt
OTP_EMAIL_BACKEND=smtp
SMTP_HOST=replace-with-your-smtp-host.example
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-smtp-username
SMTP_PASSWORD=replace-smtp-password
SMTP_SENDER=noreply@replace-with-your-domain.example
OTP_SMS_BACKEND=twilio
TWILIO_ACCOUNT_SID=replace-account-sid
TWILIO_AUTH_TOKEN=replace-auth-token
TWILIO_SENDER=replace-approved-sender
