APP_NAME=OCR and Land Mapping Service
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://ocr:change-me@db:5432/ocr_land
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_ISSUER=ocr-land-registry
AUTH_AUDIENCE=ocr-land-api
DEMO_AUTH_ENABLED=true
DEMO_ACCESS_CODE=1234
DEMO_SESSION_MINUTES=480
SECURE_UPLOAD_DIR=/var/lib/ocr/private_uploads
UPLOAD_STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=patta-documents
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=true
MAX_FILE_SIZE_MB=10
AREA_TOLERANCE_PERCENT=10
OVERLAP_MIN_SQM=1
OVERLAP_MIN_PERCENT=1
AUTOMATIC_MATCH_CONFIDENCE=0.85
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama3-70b-8192
